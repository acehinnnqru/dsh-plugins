{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // base 里是 composite: true。脚本要直接 import 工具包的 .ts 源码
    // （tsx 在开发时跑的就是源码，不必先 build），而 composite 项目禁止
    // 引用未列入自身 include 的文件（TS6307），所以这里关掉。
    "composite": false,
    "rootDir": ".",
    "outDir": "lib/types"
  },
  "include": ["scripts", "tsdown.config.ts", "vitest.config.ts"]
}
