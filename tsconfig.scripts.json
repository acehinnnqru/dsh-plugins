{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // The base sets composite: true. Scripts import tooling packages' .ts sources directly
    // (tsx runs the sources in development, so nothing has to be built first), and a composite
    // project forbids referencing files outside its own include (TS6307), so composite is off here.
    "composite": false,
    "rootDir": ".",
    "outDir": "lib/types"
  },
  "include": ["scripts", "tsdown.config.ts", "vitest.config.ts"]
}
