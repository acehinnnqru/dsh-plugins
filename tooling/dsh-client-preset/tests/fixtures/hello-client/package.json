{
  "name": "dsh-plugin-hello-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Test fixture: the smallest plugin that has both a Node half and a browser half.",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "watch": "tsc -b tsconfig.json --watch --preserveWatchOutput & tsdown --watch"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-web": "0.2.2-rc.3",
    "dsh-client-preset": "workspace:*",
    "tsdown": "0.22.14"
  }
}
