# Dependencies and build output
node_modules/
lib/
*.tsbuildinfo

# Toolchain environment: node/pnpm come from flake.nix, and both are regenerable
.direnv/

# pnpm 11 keeps its store at the repo root (.pnpm-store/v11); not tracked
/.pnpm-store/

# Personal environment: every clone creates its own, one line `use flake .`.
# The global gitignore has one too, but that is machine config; pinning it here is safer.
/.envrc

# Packing and test output
*.tgz
coverage/

# Local working notes only; these never enter git
docs/specs/
