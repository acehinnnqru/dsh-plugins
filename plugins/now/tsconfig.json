{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    // The browser half needs the DOM and JSX. Both halves compile under these options: a package has
    // one type-checking context, and halves that disagreed about globals would not be one package.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
