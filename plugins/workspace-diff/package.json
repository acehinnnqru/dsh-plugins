{
  "name": "dsh-plugin-workspace-diff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A Conversation view showing the session workspace's uncommitted git changes and their unified diffs.",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "watch": "tsc -b tsconfig.json --watch --preserveWatchOutput & tsdown --watch"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-shell": "0.2.1-alpha.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-shell": "0.2.1-alpha.5",
    "@types/react": "18.3.31",
    "dsh-client-preset": "file:../../tooling/dsh-client-preset"
  }
}
